---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid';
import { getCollection } from 'astro:content';

// Get all projects
const projects = await getCollection('projects');
const projectData = projects.map((project) => ({
  slug: project.slug,
  title: project.data.title,
  description: project.data.description || '',
  status: project.data.status,
  tags: project.data.tags,
  image: project.data.image,
  draft: project.data.draft || false,
}));

// Showcase tiles - what type of work we do
const showcaseTiles = [
  {
    title: 'We Build Web Apps',
    description: 'From sleek designs to seamless functionality, we create web applications that are intuitive, efficient, and fun to use.',
    icon: '',
    image: '/public/images/general/website_icon.png',
  },
  {
    title: 'Web Applications',
    description: 'Modern web apps built with cutting-edge frameworks for seamless user experiences.',
    icon: '',
    image: '/public/images/general/compute_icon.png',
  },
  {
    title: 'Hardware Projects',
    description: 'Physical computing, electronics, and custom hardware builds for unique challenges.',
    icon: '🔧',
  },
  {
    title: 'Data & Analytics',
    description: 'Collecting, processing, and visualizing data to uncover insights and drive decisions.',
    icon: '📊',
  },
];
---

<BaseLayout title="Haepapa - Portfolio & Projects">
  <!-- Hero Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="text-5xl md:text-6xl font-bold mb-6 pb-8">
        Welcome to <span class="text-light-grey dark:text-dark-main">Haepapa</span>
      </h1>
      <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8 mb-8">
        <div class="md:w-1/2 text-left flex flex-col">
          <h4 class="font-bold text-xl mb-2">We Turn Ideas into Real Solutions</h4>
          <p class="text-m text-light-grey dark:text-dark-grey">
            At Haepapa, we’re all about building cool stuff and teaming up to create solutions that make a difference. Whether it’s automating tasks, solving interesting problems, or learning something new, we love turning ideas into reality. Explore our projects and jump in and contribute—we’d love to have you on board!
          </p>
        </div>
        <img
          src="/images/general/haepapa_lightbulb.png"
          alt="Haepapa Hero"
          class="hidden md:block md:w-1/3 rounded-lg"
          loading="lazy"
          style="max-height: 200px; height: auto; width: auto;"
        />
      </div>
    </div>
  </section>

  <!-- What We Do Showcase Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">

    <!-- Showcase Tiles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {showcaseTiles.map((tile) => (
        <div class="bg-light-surface dark:bg-dark-surface border border-light-outline dark:border-dark-outline rounded-lg p-6 hover:border-light-main dark:hover:border-dark-main transition-all hover:shadow-lg">
          <div class="text-4xl mb-4">{tile.icon}</div>
          <img src={tile.image} alt={tile.title} class="w-12 h-12 mb-4" loading="lazy" />
          <h3 class="text-xl font-bold mb-3">{tile.title}</h3>
          <p class="text-sm text-light-grey dark:text-dark-grey">
            {tile.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="mb-12">
      <h2 class="text-4xl font-bold mb-4">What We're Working On</h2>
      <p class="text-lg text-light-grey dark:text-dark-grey">
        Browse our projects and filter by technology or interest.
      </p>
    </div>
    
    <ProjectGrid projects={projectData} client:load />
  </section>

  <!-- Contact Section -->
  <section id="contact" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-4">We'd Love to Hear From You</h2>
        <p class="text-lg text-light-grey dark:text-dark-grey">
          Have a question, suggestion, or just want to connect? Send us a message.
        </p>
      </div>

      <form class="space-y-6 bg-light-surface dark:bg-dark-surface border border-light-outline dark:border-dark-outline rounded-lg p-8">
        <div>
          <label for="name" class="block text-sm font-medium mb-2">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-2 border border-light-outline dark:border-dark-outline rounded bg-light-background dark:bg-dark-background focus:outline-none focus:ring-2 focus:ring-light-main dark:focus:ring-dark-main"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium mb-2">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2 border border-light-outline dark:border-dark-outline rounded bg-light-background dark:bg-dark-background focus:outline-none focus:ring-2 focus:ring-light-main dark:focus:ring-dark-main"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium mb-2">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full px-4 py-2 border border-light-outline dark:border-dark-outline rounded bg-light-background dark:bg-dark-background focus:outline-none focus:ring-2 focus:ring-light-main dark:focus:ring-dark-main"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full px-6 py-3 bg-light-main dark:bg-dark-main text-light-button-text dark:text-dark-button-text font-medium rounded hover:opacity-90 transition-opacity"
        >
          Send Message
        </button>
      </form>

      <p class="text-center text-sm text-light-grey dark:text-dark-grey mt-4">
        Note: Form integration with Appwrite will be configured in the environment setup.
      </p>
    </div>
  </section>
</BaseLayout>
