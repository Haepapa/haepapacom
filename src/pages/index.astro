---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid';
import { getCollection } from 'astro:content';

// Get all projects
const projects = await getCollection('projects');
const projectData = projects.map((project) => ({
  slug: project.slug,
  title: project.data.title,
  description: project.data.description || '',
  status: project.data.status,
  tags: project.data.tags,
  image: project.data.image,
  image_dark: project.data.image_dark,
  draft: project.data.draft || false,
}));

// Showcase tiles - what type of work we do
const showcaseTiles = [
  {
    title: 'We Build Web Apps',
    description: 'From sleek designs to seamless functionality, we create web applications that are intuitive, efficient, and fun to use.',
    icon: '',
    image: '/public/images/general/website_icon.png',
    image_dark: '/public/images/general/website_icon_dark.png',
  },
  {
    title: 'We Build Desktop Apps',
    description: 'Our desktop apps simplify tasks and solve problems, with a focus on making life easier—whatever the challenge.',
    icon: '',
    image: '/public/images/general/compute_icon.png',
    image_dark: '/public/images/general/compute_icon_dark.png',
  },
  {
    title: 'We Build Whatever Seems Fun',
    description: 'If it’s interesting, creative, or just plain cool, we’ll dive in and make it happen. No idea is off-limits!',
    icon: '',
    image: '/public/images/general/build_icon.png',
    image_dark: '/public/images/general/build_icon_dark.png',
  },
  {
    title: 'We Bring Data to Life',
    description: 'Whether it’s platforms, tools, or solutions powered by AI, we build to help uncover insights and solve data challenges.',
    icon: '',
    image: '/public/images/general/data_icon.png',
    image_dark: '/public/images/general/data_icon_dark.png',
  },
];
---

<BaseLayout title="Haepapa - Portfolio & Projects">
  <!-- Hero Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="text-center max-w-3xl mx-auto">
      <!-- <h1 class="text-5xl md:text-6xl font-bold mb-6 pb-8">
        Welcome to <span class="text-light-grey dark:text-dark-main">Haepapa</span>
      </h1> -->
      <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8 mb-8">
        <div class="md:w-1/2 text-left flex flex-col">
          <h4 class="font-bold text-xl mb-2">We Turn Ideas into Real Solutions</h4>
            <p class="text-m text-light-black dark:text-dark-grey font-light">
            At Haepapa, we’re all about building cool stuff and teaming up to create solutions that make a difference. Whether it’s automating tasks, solving interesting problems, or learning something new, we love turning ideas into reality. Explore our projects and jump in and contribute—we’d love to have you on board!
            </p>
        </div>
          <img
            src="/images/general/haepapa_lightbulb.png"
            alt="Haepapa Hero"
            class="md:w-1/3 rounded-lg block dark:hidden"
            loading="lazy"
            style="max-height: 200px; height: auto; width: auto;"
          />
          <img
            src="/images/general/haepapa_lightbulb_dark.png"
            alt="Haepapa Hero Dark"
            class="md:w-1/3 rounded-lg hidden dark:block"
            loading="lazy"
            style="max-height: 200px; height: auto; width: auto;"
          />
      </div>
    </div>
  </section>

  <!-- What We Do Showcase Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-5">

    <!-- Showcase Tiles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {showcaseTiles.map((tile) => (
        <div class="bg-light-surface dark:bg-dark-surface border border-light-grey dark:border-dark-outline rounded-lg p-6 hover:border-light-grey dark:hover:border-dark-main transition-all hover:shadow-lg">
          <div class="text-4xl mb-4">{tile.icon}</div>
            <img src={tile.image} alt={tile.title} class="w-12 h-12 mb-4 mx-auto block dark:hidden" loading="lazy" />
            <img src={tile.image_dark} alt={tile.title} class="w-12 h-12 mb-4 mx-auto hidden dark:block" loading="lazy" />
            <h3 class="text-xl font-bold mb-3 text-center">{tile.title}</h3>
            <p class="text-sm text-light-black dark:text-dark-grey font-light">
              {tile.description}
            </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="mb-12">
      <h2 class="text-4xl font-bold mb-4">What We're Working On</h2>
    </div>
    
    <ProjectGrid projects={projectData} client:load />
  </section>

  <!-- Contact Section -->
  <section id="contact" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-4">We'd Love to Hear From You</h2>
        <p class="text-lg text-light-grey dark:text-dark-grey">
          Have a question, suggestion, or just want to connect? Send us a message.
        </p>
      </div>

      <form class="space-y-6 bg-light-surface dark:bg-dark-surface border border-light-grey dark:border-dark-outline rounded-lg p-8">
        <div>
          <label for="name" class="block text-sm font-medium mb-2">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-2 border border-light-grey dark:border-dark-outline rounded bg-light-background dark:bg-dark-background focus:outline-none focus:ring-2 focus:ring-light-main dark:focus:ring-dark-main"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium mb-2">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2 border border-light-grey dark:border-dark-outline rounded bg-light-background dark:bg-dark-background focus:outline-none focus:ring-2 focus:ring-light-main dark:focus:ring-dark-main"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium mb-2">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full px-4 py-2 border border-light-grey dark:border-dark-outline rounded bg-light-background dark:bg-dark-background focus:outline-none focus:ring-2 focus:ring-light-main dark:focus:ring-dark-main"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full px-6 py-3 border border-light-grey dark:border-dark-outline hover:border-light-outline dark:hover:border-dark-main font-medium rounded hover:opacity-90 transition-opacity"
        >
          Send Message
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
